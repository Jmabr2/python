import discord
import random

# A variável intents armazena as permissões do bot
intents = discord.Intents.default()
# Ativar a permissão para ler o conteúdo das mensagens
intents.message_content = True
# Criar um bot e passar as permissões
client = discord.Client(intents=intents)

@client.event
async def on_ready():
    print(f'Fizemos login como {client.user}')

@client.event
async def on_message(message):
    if message.author == client.user:
        return

    if message.content.startswith('$ajuda'):
        ajuda = (
            "**Comandos do Botzão:**\n"
            "- `$hello` - Diz olá em inglês\n"
            "- `$bye` - Manda um emoji de despedida\n"
            "- `$nome` - O bot se apresenta\n"
            "- `$adivinha` - Tenta adivinhar um número de 1 a 5 (Ex: `$adivinha 3`)\n"
            "- `$frase` - Manda uma frase aleatória\n"
            "- `$senha` - Gera uma senha aleatória segura"
        )
        await message.channel.send(ajuda)

    elif message.content.startswith('$hello'):
        await message.channel.send("Hello!")

    elif message.content.startswith('$bye'):
        await message.channel.send("\U0001f642")

    elif message.content.startswith('$nome'):
        await message.channel.send(f"Olá! O meu nome é botzão. E qual é o seu nome, {message.author.mention}?")

    elif message.content.startswith('$adivinha'):
        numero_secreto = random.randint(1, 5)
        partes = message.content.split()

        if len(partes) < 2:
            await message.channel.send("Digite um número de 1 a 5 junto com o comando! Exemplo: `$adivinha 3`")
        elif partes == str(numero_secreto):
            await message.channel.send(f"Parabéns {message.author.mention}! Você acertou, o número era **{numero_secreto}**!")
        else:
            await message.channel.send(f"Errou! Você escolheu {partes}, mas eu pensei no número **{numero_secreto}**.")

    elif message.content.startswith('$frase'):
        frases = [
            "O código só funciona na segunda tentativa!",
            "Não deixe para amanhã o bug que você pode resolver hoje.",
            "Café: o combustível oficial dos programadores.",
            "Você está indo muito bem na criação do seu bot!"
        ]
        await message.channel.send(random.choice(frases))

    elif message.content.startswith('$senha'):
        caracteres = "+-/*!&$?=@abcdefghijklnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
        senha = ""
        for i in range(10):
            senha += random.choice(caracteres)
        await message.channel.send(f"Sua nova senha gerada é: `{senha}`")

client.run("")
